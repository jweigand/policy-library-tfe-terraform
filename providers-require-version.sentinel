# This policy blocks Terraform Apply when a provider does not meet version constraint requirements.

import "tfconfig/v2" as tfconfig
import "strings"

violating_providers = filter tfconfig.providers as _, p {
	p.version_constraint is "" or
		strings.has_prefix(p.version_constraint, ">") # this prevents the use of some version constraint operators that would permissively allow major version upgrades
}

if length(violating_providers) > 0 {
	print("These providers do not have an acceptable version constraint:")
	for violating_providers as _, p {
		print(" - " + _ + " (" + p.full_name + ")" + " | version constraint: \"" + p.version_constraint + "\"")
	}
}

main = rule {
	length(violating_providers) == 0
}
